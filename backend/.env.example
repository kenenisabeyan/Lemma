# =========================================================================
# BACKEND ENVIRONMENT CONFIGURATION (RENDER / PRODUCTION)
# =========================================================================

# Port assigned by cloud provider (Render provides PORT dynamically, default 10000 or 5000)
PORT=5000

# Node Environment
NODE_ENV=production

# SQLite Database connection string for Prisma
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Auth (Generate a secure 64+ char random string in production)
JWT_SECRET="replace_with_a_secure_random_secret_key_at_least_32_chars"

# JWT expiration
JWT_EXPIRES_IN="7d"

# Allowed frontend origin(s) for CORS. Can be comma-separated or '*' to allow all.
# Example: https://lema-portfolio.vercel.app,http://localhost:5173
CORS_ORIGIN="*"

