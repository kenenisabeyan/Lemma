# URL of your deployed Render backend (e.g. https://lema-portfolio-backend.onrender.com)
# When set, all API calls go to this backend.
# If omitted or left empty, calls fallback to local '/api' (proxied via Vite or Vercel rewrites)
VITE_API_BASE_URL="https://your-backend-service.onrender.com"

